# E release. Existing public platform bases supply CUDA PyTorch, ROS and AudioChunk.
ARG JP_VERSION=61
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/perception@sha256:7de48bf82849c3bc402fa1d2b79469932473b452a0455f78d0da551682143854 AS jp61
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/perception@sha256:c4e652a9e0cbba466006c3adddab5bdc01c45ebabdb89f1f95c76757245c3410 AS jp511
FROM jp61 AS jp6
FROM jp511 AS jp5
FROM jp${JP_VERSION}
ARG JP_VERSION
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/xiaoyou-python:/work \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 CUDA_MODULE_LOADING=LAZY \
    OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    XDG_CACHE_HOME=/tmp/cache CUDA_CACHE_PATH=/tmp/cuda PYTORCH_KERNEL_CACHE_PATH=/tmp/torch-kernels \
    FASTRTPS_DEFAULT_PROFILES_FILE=/opt/xiaoyou-fastdds.xml ROS_LOCALHOST_ONLY=0 RCUTILS_COLORIZED_OUTPUT=0 ROS_LOG_DIR=/tmp/ros-log ROS_HOME=/tmp/ros-home CONFIG_PATH=/work/config.yaml
COPY tools/download_xiaoyou_assets.py tools/install_xiaoyou_runtime.py /opt/
COPY perception/xiaoyou_runtime_*.json /opt/runtime-manifests/
COPY perception/xiaoyou_e_assets.json /opt/xiaoyou_e_assets.json
RUN python3 -B /opt/install_xiaoyou_runtime.py --jp-version ${JP_VERSION} && \
    python3 -B /opt/download_xiaoyou_assets.py --manifest /opt/xiaoyou_e_assets.json --destination /models/kokoro-xiaoyou-e
WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/deploy/xiaoyou-fastdds.xml /opt/xiaoyou-fastdds.xml
COPY tools/test_xiaoyou_mcp.py tools/check_xiaoyou_frontend.py /opt/
RUN python3 -B -c "from importlib.metadata import version; from plugins.xiaoyou_kokoro.runtime import verify_assets; assert version('misaki') == '0.9.4'; assert version('en-core-web-sm') == '3.8.0'; assert verify_assets('/models/kokoro-xiaoyou-e')['voice'] == 'E'"
ARG SOURCE_SHA
LABEL owner="wangaodi" project="tts_xiaoyou" io.4pd.source_sha256="${SOURCE_SHA}"
EXPOSE 15720 15721
CMD ["/bin/bash", "-c", "mkdir -p /tmp/cache /tmp/cuda /tmp/torch-kernels && source /opt/ros/humble/install/setup.bash && source /ros_ws/install/setup.bash && exec python3 -B /work/main.py"]
