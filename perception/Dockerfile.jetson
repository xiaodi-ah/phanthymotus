# JP6.1 trial: engines were built on Orin / CUDA12.6 / TensorRT10.4.0.
ARG BASE_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/perception:release.261010.37994d2-jetson-jp6.1
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 TTS_PLUGIN=moss_tts
COPY perception/moss_assets.json /opt/moss_assets.json
COPY tools/download_moss_assets.py /opt/download_moss_assets.py
RUN python3 /opt/download_moss_assets.py --manifest /opt/moss_assets.json --destination /models/moss-tts-trt-jp61-v2 && \
    PIP_CONFIG_FILE=/dev/null python3 -m pip install --no-cache-dir --no-index --no-deps --ignore-installed \
      /models/moss-tts-trt-jp61-v2/wheels/*.whl && \
    python3 -B -c "import numpy, scipy, sentencepiece, onnxruntime; assert numpy.__version__=='1.26.4'"
WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY tools/test_moss_submission.py /opt/test_moss_submission.py
COPY tools/test_moss_mcp.py /opt/test_moss_mcp.py
EXPOSE 15720 15721
CMD ["/bin/bash", "-c", "source /opt/ros/humble/install/setup.bash && source /ros_ws/install/setup.bash && python3 -B /work/main.py"]
